# Copy this file to .env and fill in your values
# Open-Meteo is free and does not require an API key
# IMD API key (optional, for India Meteorological Department)
IMD_API_KEY=your_imd_api_key_here
# Copernicus Data Space credentials (optional, for DEM downloads)
COPERNICUS_USER=your_username
COPERNICUS_PASS=your_password
# App configuration
APP_ENV=development
CACHE_DIR=./cache
LOG_LEVEL=INFO
